local function jumpReveal(tx, tz)
    local cx = X0 + (tx - 1) * STEP
    local cz = Z0 + (tz - 1) * STEP
    local hrp = getHRP()
    if hrp then
        local p = hrp.Position
        if math.abs(p.X - cx) > 0.5 or math.abs(p.Z - cz) > 0.5 then
            hrp.CFrame = CFrame.new(cx, p.Y, cz)
        end
    end
    for i = 1, 5 do
        if tileRevealed(tx, tz) then return true end
        task.wait(0.00000003)
    end
    return tileRevealed(tx, tz)
end
local function hopReveal(tx, tz)
    local cx = X0 + (tx - 1) * STEP
    local cz = Z0 + (tz - 1) * STEP
    for i = 1, 3 do
        if tileRevealed(tx, tz) then return true end
        local hrp = getHRP()
        if not hrp then return false end
        local baseY = hrp.Position.Y
        hrp.CFrame = CFrame.new(cx, baseY + 3, cz)
        task.wait(0.00000003)
        hrp = getHRP()
        if not hrp then return false end
        hrp.CFrame = CFrame.new(cx, baseY, cz)
        task.wait(0.00000003)
    end
    return tileRevealed(tx, tz)
end

