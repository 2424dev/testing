local function detectMode()
    local ok, folder = pcall(function()
        return ws:FindFirstChild("Flag") and ws:FindFirstChild("Flag"):FindFirstChild("Parts")
    end)
    if ok and folder then
        local kids = folder:GetChildren()
        if #kids >= 2 then
            local minX, maxX, minZ, maxZ = 1e9, -1e9, 1e9, -1e9
            for _, p in ipairs(kids) do
                local cn = p.ClassName
                if cn == "Part" or cn == "MeshPart" or cn == "WedgePart" then
                    local px, pz = p.Position.X, p.Position.Z
                    if px < minX then minX = px end
                    if px > maxX then maxX = px end
                    if pz < minZ then minZ = pz end
                    if pz > maxZ then maxZ = pz end
                end
            end
            if maxX > minX and maxZ > minZ then
                local sx = math.floor((maxX - minX) / 5 + 0.5) + 1
                local sz = math.floor((maxZ - minZ) / 5 + 0.5) + 1
                isInfinite = (sx < 20 or sz < 20)
            end
        end
    end
    updateModeSettings()
end
