local function roundTick()
    local info2 = game.ReplicatedStorage:FindFirstChild("Info")
    local gr2 = info2 and info2:FindFirstChild("GameRunning")
    local gr = gr2 and gr2.Value
    uiState.round = gr and "Running" or "Ended"
    local snap = scanRes
    if snap and snap.revealed and snap.revealed > peakRevealed then peakRevealed = snap.revealed end
    if gr ~= prevGR then
        if gr then
            failedTiles = {}; failedCount = {}; flaggedTiles = {}; flagRecent = {}; flagSticky = nil
            scanRes = nil; scanGen = scanGen + 1
            if prevGR ~= nil then
                if peakRevealed >= 524 then stats.wins = stats.wins + 1
                else stats.losses = stats.losses + 1 end
            end
            peakRevealed = 0
            if fsTriggered then
                fsTriggered = false
                apEnabled = true
                failedTiles = {}; failedCount = {}; fsBase = tick()
            end
        end
        prevGR = gr
    end
    fsElapsed = (apEnabled and gr and (tick() - fsBase)) or 0
    if fsTriggered then
        local hrpCheck = getHRP()
        if hrpCheck and hrpCheck.Position.Y > -100 then
            fsTriggered = false
            apEnabled = true
            failedTiles = {}; failedCount = {}; fsBase = tick()
        end
    end
    if failSafeEnabled and apEnabled and gr and not fsTriggered and tick() - fsBase > fsTime then
        fsTriggered = true; apEnabled = false
        local hrpFS = getHRP()
        if hrpFS then hrpFS.CFrame = CFrame.new(hrpFS.Position.X, -200, hrpFS.Position.Z) end
    end
    if watchOn then
        local inGame = {}
        for _, p in ipairs(Players:GetPlayers()) do inGame[p.Name:lower()] = true end
        for _, n in ipairs(watchNames) do
            if n ~= "" then
                local key = n:lower()
                local wasHere = watchPresence[key]
                local isHere = inGame[key] == true
                watchPresence[key] = isHere
                if wasHere and not isHere then apEnabled = false end
            end
        end
    end
end

local function autoTick()
    local info2 = game.ReplicatedStorage:FindFirstChild("Info")
    local gr2 = info2 and info2:FindFirstChild("GameRunning")
    local gr = gr2 and gr2.Value
          if apEnabled and gr then
        local hrp2 = getHRP()
        local now = tick()
        if hrp2 and now >= apCooldown then
            local snap = scanRes
            local pos = hrp2.Position
            if snap then
                local target
                local anySafeExist = false
                for _, t in ipairs(snap.safeTiles) do
                    if not tileRevealed(t.x, t.z) then
                        anySafeExist = true
                        break
                    end
                end
                local anySafeRemaining = false
                for _, t in ipairs(snap.safeTiles) do
                    if not tileRevealed(t.x, t.z) then
                        local k2 = t.x .. "," .. t.z
                        if not (failedTiles[k2] and now - failedTiles[k2] < FAIL_WIN) then
                            anySafeRemaining = true
                            local d = (t.pos.X - pos.X)^2 + (t.pos.Z - pos.Z)^2
                            if not target or d < (target._d or math.huge) then target = t; target._d = d end
                        end
                    end
                end
                if not target and snap.probs and not anySafeExist then
                    local bpg
                    for _, pr in ipairs(snap.probs) do
                        if not tileRevealed(pr.x, pr.z) then
                            local k2 = pr.x .. "," .. pr.z
                            if not (failedTiles[k2] and now - failedTiles[k2] < FAIL_WIN) then
                                if not bpg or pr.pct < bpg.pct then bpg = pr end
                            end
                        end
                    end
                    if bpg then
                        target = { x = bpg.x, z = bpg.z, pos = bpg.pos }
                        stats.guesses = stats.guesses + 1
                    end
                end
                if not target and snap.unrevealed and not anySafeExist then
                    local mineKeys = {}
                    if snap.markers then
                        for _, mm in ipairs(snap.markers) do
                            if mm.x and mm.z then mineKeys[mm.x .. "," .. mm.z] = true end
                        end
                    end
                    local bestU
                    for _, u in ipairs(snap.unrevealed) do
                        if not mineKeys[u.x .. "," .. u.z] then
                            if not tileRevealed(u.x, u.z) then
                                local k2 = u.x .. "," .. u.z
                                if not (failedTiles[k2] and now - failedTiles[k2] < FAIL_WIN) then
                                    local d = (u.pos.X - pos.X)^2 + (u.pos.Z - pos.Z)^2
                                    if not bestU or d < bestU.d then bestU = { t = u, d = d } end
                                end
                            end
                        end
                    end
                    if bestU then
                        target = { x = bestU.t.x, z = bestU.t.z, pos = bestU.t.pos }
                        stats.guesses = stats.guesses + 1
                    end
                end
                if target then
                    if not tileRevealed(target.x, target.z) then
                        local tkey = target.x .. "," .. target.z
                        if jumpReveal(target.x, target.z) then
                            apCooldown = tick() + speedInterval(); failedCount[tkey] = 0
                        else
                            failedCount[tkey] = (failedCount[tkey] or 0) + 1
                            if failedCount[tkey] >= 2 then
                                failedCount[tkey] = 0; failedTiles[tkey] = tick()
                                apCooldown = tick() + 0.00003
                            else
                                local hasNext = false
                                for _, t in ipairs(snap.safeTiles) do
                                    if not (t.x == target.x and t.z == target.z) then
                                        if not tileRevealed(t.x, t.z) then
                                            local k2 = t.x .. "," .. t.z
                                            if not (failedTiles[k2] and now - failedTiles[k2] < FAIL_WIN) then
                                                hasNext = true; break
                                            end
                                        end
                                    end
                                end
                                if hasNext then
                                    failedTiles[tkey] = tick(); apCooldown = tick() + 0.00001
                                elseif hopReveal(target.x, target.z) then
                                    apCooldown = tick() + speedInterval(); failedCount[tkey] = 0
                                else
                                    failedTiles[tkey] = tick(); apCooldown = tick() + 0.000025
                                end
                            end
                        end
                    else
                        apCooldown = tick() + speedInterval()
                    end
                else
                    apCooldown = tick() + (anySafeRemaining and 0.002 or 0.005)
                end
            else
                apCooldown = tick() + 0.00005
            end
        end
    end
end

local function flagTick()
          if autoFlag and scanRes then
        local now = tick()
        if flagPending then
            local pf = tileFlagged(flagPending.x, flagPending.z)
            if pf ~= flagPending.unflag then
                if not flagPending.unflag then flaggedTiles[flagPending.key] = true else flaggedTiles[flagPending.key] = nil end
                flagRecent[flagPending.key] = now
                flagSticky = nil
                flagPending = nil
                flagCooldown = now + 0.005
            elseif now - flagPending.t > 0.3 then
                flaggedTiles[flagPending.key] = nil
                flagRecent[flagPending.key] = now - 0.05
                if not flagPending.unflag then flagSticky = flagPending.key end
                flagPending = nil
                flagCooldown = now + 0.01
            end
        elseif now >= flagCooldown and now >= flagSearchCooldown then
            flagSearchCooldown = now + 0.004
            local hrpF = getHRP()
            if hrpF then
                local pPos = hrpF.Position
                local mxS = lp and lp:GetMouse()
                local pick
                if flagSticky then
                    local sxg, szg = flagSticky:match("^(%-?%d+),(%-?%d+)")
                    local gx, gz = tonumber(sxg), tonumber(szg)
                    local sp = gx and g_partsByKey[flagSticky]
                    local solverSafe = false
                    if sp and scanRes.safeTiles then
                        for _, st2 in ipairs(scanRes.safeTiles) do
                            if st2.x == gx and st2.z == gz then solverSafe = true break end
                        end
                    end
                    if solverSafe then
                        flagSticky = nil
                    elseif sp and not tileFlagged(gx, gz) and not tileRevealed(gx, gz) and (sp.Position - pPos).Magnitude <= RANGE * 1.5 then
                        local s, ok = WorldToScreen(sp.Position)
                        if ok and s.X > 0 and s.Y > 0 and mxS then
                            pick = { sx = s.X, sy = s.Y, gx = gx, gz = gz, key = flagSticky, unflag = false }
                        else
                            flagSticky = nil
                        end
                    else
                        flagSticky = nil
                    end
                end
                if not pick and scanRes.markers then
                    for _, m in ipairs(scanRes.markers) do
                        if m.pos and m.x and m.z then
                            local key = m.x .. "," .. m.z
                            if not flaggedTiles[key] and not tileFlagged(m.x, m.z) and not tileRevealed(m.x, m.z) and (flagRecent[key] or 0) <= now - 0.2 then
                                if (m.pos.X - pPos.X)^2 + (m.pos.Z - pPos.Z)^2 <= RANGE * RANGE then
                                    local s, ok = WorldToScreen(m.pos)
                                    if ok and s.X > 0 and s.Y > 0 then
                                        pick = { sx = s.X, sy = s.Y, gx = m.x, gz = m.z, key = key, unflag = false }
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
                if not pick and scanRes.safeTiles then
                    for _, st in ipairs(scanRes.safeTiles) do
                        local key = st.x .. "," .. st.z
                        if not flaggedTiles[key] and tileFlagged(st.x, st.z) and (flagRecent[key] or 0) <= now - 0.2 then
                            if (st.pos.X - pPos.X)^2 + (st.pos.Z - pPos.Z)^2 <= RANGE * RANGE then
                                local s, ok = WorldToScreen(st.pos)
                                if ok and s.X > 0 and s.Y > 0 then
                                    pick = { sx = s.X, sy = s.Y, gx = st.x, gz = st.z, key = key, unflag = true }
                                    break
                                end
                            end
                        end
                    end
                end
                if pick and mxS then
                    mousemoveabs(math.floor(pick.sx + 0.5), math.floor(pick.sy + 0.5))
                    mouse1click()
                    flagRecent[pick.key] = now
                    flagSticky = pick.unflag and nil or pick.key
                    flagPending = { key = pick.key, x = pick.gx, z = pick.gz, unflag = pick.unflag, t = now }
                    flagCooldown = now + 0.01
                end
            end
        end
    end
end

