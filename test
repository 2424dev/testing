local nCkCache = {}
local function nCk(n, k)
    if k < 0 or k > n then return 0 end
    k = math.min(k, n - k)
    local key = n * 4096 + k
    local c = nCkCache[key]
    if c ~= nil then return c end
    local v = 1
    for i = 1, k do v = v * (n - k + i) / i end
    nCkCache[key] = v
    return v
end
local function enumerate(cellsList, consList, cap, deadline)
    local solutions, state = {}, {}
    if not deadline then deadline = tick() + 0.05 end
    local degIdx = {}
    for _, con in ipairs(consList) do
        for _, c in ipairs(con.cells) do
            local l = degIdx[c]
            if not l then l = {}; degIdx[c] = l end
            l[#l + 1] = con
        end
    end
    local nodes = 0
    local function reduce(forcedOut)
        local ch = true
        while ch do
            ch = false
            for _, con in ipairs(consList) do
                local k, u = 0, 0
                for _, c in ipairs(con.cells) do
                    local v = state[c]
                    if v == 1 then k = k + 1 elseif v == nil then u = u + 1 end
                end
                if k > con.need or k + u < con.need then return false end
                if u > 0 then
                    if k == con.need then
                        for _, c in ipairs(con.cells) do if state[c] == nil then state[c] = 0; forcedOut[#forcedOut + 1] = c; ch = true end end
                    elseif k + u == con.need then
                        for _, c in ipairs(con.cells) do if state[c] == nil then state[c] = 1; forcedOut[#forcedOut + 1] = c; ch = true end end
                    end
                end
            end
        end
        return true
    end
    local function bestBranch()
        local best, bestScore
        for _, con in ipairs(consList) do
            local k, u = 0, 0
            for _, c in ipairs(con.cells) do
                local v = state[c]
                if v == 1 then k = k + 1 elseif v == nil then u = u + 1 end
            end
            if u > 0 then
                local score = nCk(u, con.need - k)
                if not bestScore or score < bestScore then bestScore = score; best = con end
            end
        end
        if not best then return nil end
        local bc
        local bdeg = -1
        for _, c in ipairs(best.cells) do
            if state[c] == nil then
                local deg = #(degIdx[c] or {})
                if deg > bdeg then bdeg = deg; bc = c end
            end
        end
        return bc
    end
    local function dfs()
        if nodes >= NODE_BUDGET or #solutions >= cap then return end
        if tick() > deadline then return end
        nodes = nodes + 1
        local forced = {}
        if reduce(forced) then
            local cell = bestBranch()
            if cell == nil then
                local sol = {}
                for i, c in ipairs(cellsList) do if state[c] == 1 then sol[#sol + 1] = i end end
                solutions[#solutions + 1] = sol
            else
                state[cell] = 1
                dfs()
                state[cell] = nil
                if nodes < NODE_BUDGET and #solutions < cap then
                    state[cell] = 0
                    dfs()
                    state[cell] = nil
                end
            end
        end
        for i = 1, #forced do state[forced[i]] = nil end
    end
    dfs()
    return solutions
end
local function scanBoard()
    detectBoard()
    local scanDeadline = tick() + (isInfinite and 0.03 or 0.2)
    local ok, folder = pcall(function()
        return ws:FindFirstChild("Flag") and ws:FindFirstChild("Flag"):FindFirstChild("Parts")
    end)
    if not ok or not folder then return nil end
    local parts = folder:GetChildren()
    local grid = {}
    local allUnk = {}
    local pbk = {}
    local revealed = 0
    local unrevealed = {}
    for x = 1, SIZE do grid[x] = {} end
    for _, part in ipairs(parts) do
        local cn = part.ClassName
        if cn == "Part" or cn == "MeshPart" or cn == "WedgePart" then
            local pos = part.Position
            local cx = math.floor((pos.X - X0) / STEP + 0.5) + 1
            local cz = math.floor((pos.Z - Z0) / STEP + 0.5) + 1
            if cx >= 1 and cx <= SIZE and cz >= 1 and cz <= SIZE then
                local st, num
                local gui = part:FindFirstChild("NumberGui")
                if gui then revealed = revealed + 1 end
                local r, g = part.Color.R, part.Color.G
                local function nn(x) if x > 1 then return x / 255 else return x end end
                local bright = nn(r) > 0.66 and nn(g) > 0.66
                if gui then
                    local okT, txt = pcall(function()
                        local lab = gui:FindFirstChildOfClass("TextLabel")
                        return lab and lab.Text
                    end)
                    num = okT and tonumber(txt)
                    if num then st = "num" elseif bright then st = "rev" else st = "oth" end
                else
                    if bright then st = "neu" else st = "hid" end
                end
                local cell = { pos = pos, x = cx, z = cz, st = st, n = num, mines = nil, frontier = false }
                grid[cx][cz] = cell
                pbk[cx .. "," .. cz] = part
                if st == "hid" then allUnk[#allUnk + 1] = cell end
                if not gui then unrevealed[#unrevealed + 1] = { x = cx, z = cz, pos = pos } end
            end
        end
    end
    g_partsByKey = pbk
    local constraints = {}
    for x = 1, SIZE do
        for z = 1, SIZE do
            local cell = grid[x][z]
            if cell and cell.st == "num" and cell.n ~= nil then
                local neigh = {}
                for _, d in ipairs(DIRS) do
                    local nx, nz = x + d[1], z + d[2]
                    if nx >= 1 and nx <= SIZE and nz >= 1 and nz <= SIZE then
                        local nb = grid[nx][nz]
                        if nb and nb.st == "hid" then
                            nb.frontier = true
                            neigh[#neigh + 1] = nb
                        end
                    end
                end
                if #neigh > 0 then constraints[#constraints + 1] = { cells = neigh, need = cell.n } end
            end
        end
    end
    local changed = true
    while changed do
        changed = false
        for _, con in ipairs(constraints) do
            local known, un = 0, 0
            for _, c in ipairs(con.cells) do
                if c.mines == 1 then known = known + 1 elseif c.mines == nil then un = un + 1 end
            end
            local need = con.need
            if known > need or known + un < need then return nil end
            if un > 0 then
                if known == need then
                    for _, c in ipairs(con.cells) do if c.mines == nil then c.mines = 0; changed = true end end
                elseif known + un == need then
                    for _, c in ipairs(con.cells) do if c.mines == nil then c.mines = 1; changed = true end end
                end
            end
        end
    end
    local parent = {}
    local function find(a)
        local p = a
        while parent[p] ~= nil and parent[p] ~= p do p = parent[p] end
        parent[a] = p
        return p
    end
    local function union(a, b)
        local ra, rb = find(a), find(b)
        if ra ~= rb then parent[ra] = rb end
    end
    local compCells, compCons = {}, {}
    for _, con in ipairs(constraints) do
        local members = {}
        for _, c in ipairs(con.cells) do
            if c.mines == nil then
                members[#members + 1] = c
                if parent[c] == nil then parent[c] = c end
            end
        end
        for i = 2, #members do union(members[1], members[i]) end
    end
    for _, con in ipairs(constraints) do
        local members, known = {}, 0
        for _, c in ipairs(con.cells) do
            if c.mines == 1 then known = known + 1 elseif c.mines == nil then members[#members + 1] = c end
        end
        if #members > 0 then
            local root = find(members[1])
            if not compCons[root] then compCons[root] = {} end
            compCons[root][#compCons[root] + 1] = { cells = members, need = con.need - known }
            local lst = compCells[root]
            if not lst then lst = {}; compCells[root] = lst end
            for _, m in ipairs(members) do
                if not m._inComp then m._inComp = true; lst[#lst + 1] = m end
            end
        end
    end
    local outM, outS, outP = {}, {}, {}
    local safeTiles = {}
    for _, c in ipairs(allUnk) do
        if c.frontier then
            if c.mines == 1 then
                outM[#outM + 1] = { pos = c.pos, x = c.x, z = c.z }
            elseif c.mines == 0 then
                outS[#outS + 1] = c.pos
                safeTiles[#safeTiles + 1] = { x = c.x, z = c.z, pos = c.pos }
            end
        end
    end
    for root, cellsList in pairs(compCells) do
        local solutions = enumerate(cellsList, compCons[root], 100, scanDeadline)
        local mcomp = #cellsList
        if #solutions > 0 then
            local probs = {}
            for i = 1, mcomp do probs[i] = 0 end
            for _, sol in ipairs(solutions) do
                for _, ci in ipairs(sol) do probs[ci] = probs[ci] + 1 end
            end
            for i = 1, mcomp do probs[i] = probs[i] / #solutions end
            for i, c in ipairs(cellsList) do
                if c.frontier then
                    local p = probs[i]
                    if p >= 0.99 then
                        outM[#outM + 1] = { pos = c.pos, x = c.x, z = c.z }
                    elseif p <= 0.0001 then
                        outS[#outS + 1] = c.pos
                        safeTiles[#safeTiles + 1] = { x = c.x, z = c.z, pos = c.pos }
                    else
                        outP[#outP + 1] = { pos = c.pos, pct = math.floor(p * 100 + 0.5), x = c.x, z = c.z }
                    end
                end
            end
        end
    end
    return { markers = outM, safes = outS, probs = outP, safeTiles = safeTiles, unrevealed = unrevealed, revealed = revealed }
end

